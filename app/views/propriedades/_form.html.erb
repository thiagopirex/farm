<%= form_for(@propriedade) do |f| %>
  <% if @propriedade.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@propriedade.errors.count, "erro(s)") %> impede de criar esta propriedade:</h2>

      <ul>
      <% @propriedade.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <%= hidden_field_tag(:sede_ponto, 'valor') %>
  <div class="row mb-3">
	<%= f.label :Nome , class: "col-sm-2 col-form-label"%>
	<div class="col-sm-10">
      	<%= f.text_field :nome, class: "form-control" %>
    </div>
  </div>
  <div class="row mb-3">
	<%= f.label :NIRF  , class: "col-sm-2 col-form-label"%>
	<div class="col-sm-10">
    	<%= f.text_field :nirf, class: "form-control" %>
	</div>
  </div>
  
  <div class="d-flex justify-content-end">
	<% if @propriedade.id.nil?%>
		<%= link_to 'Voltar', propriedades_path, class:"btn btn-secondary" %>
	<% else %>
		<%= link_to 'Voltar', @propriedade, class:"btn btn-secondary" %>
	<% end %>
	<%= button_tag f.object.new_record? ? "Criar" : "Atualizar", type: "submit", class: "btn btn-outline-success" %></button>
  </div>
  <div id="map" data-controller="map" style="margin-top: 10px; width: 100%; height: 100%"></div>

  <%= javascript_tag type:"module" do %>
	document.addEventListener("turbo:load", () => {

	});
  <% end %>
<% end %>
        